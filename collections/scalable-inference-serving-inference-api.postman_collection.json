          "name": "Run Model Inference",
          "request": {
            "name": "Run Model Inference",
            "description": {
              "content": "Submit an inference request to a model. The request body contains the input tensors as JSON. Inputs are specified as an array of named tensors with shape, datatype, and data fields. The response contains the model's output tensors.\nFor large tensor payloads, the binary tensor data extension allows sending tensor data as binary in the request body alongside the JSON header.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "models",
                ":model_name",
                "infer"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "model_name",
                  "description": "(Required) Name of the model to run inference against."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
